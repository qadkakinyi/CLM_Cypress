{
  "name": "clm_cypress",
  "version": "1.0.0",
  "description": "This project contains Automated E2E tests for the Regtech_CLM",
  "main": "index.js",
  "scripts": {
    "cypress:open": "cypress open",
    "cypress:run": "npm run prereport && cypress run --browser electron",
    "cypress:run-specific": "cypress run --browser chrome --spec \"/app/cypress/e2e/IndividualClientFunctionality/Add_Edit_Delete_Client_Evaluation_test.cy.ts\"",
    "delete:reports": "rm -rf /app/cypress/results/* || true",
    "prereport": "npm run delete:reports",
    "mochawesome:merge": "npx mochawesome-merge \"cypress/results/mochawesome/*.json\" > mochawesome.json && npx marge mochawesome.json",
    "junit:merge": "npx junit-merge -d cypress/results/junit -o cypress/results/junit/result.xml",
    "cypress:Priority1": "cypress run --record --parallel --group priority1 --spec 'cypress/e2e/AddClients/*.cy.ts'",
    "cypress:Priority2": "cypress run --record --parallel --group priority2 --spec 'cypress/e2e/OtherTests/**/*.cy.ts'",
    "cypress:record": "cypress run --record --key 84a81a28-ebac-46c5-ab74-9fc43f7e0f56"
  },
  "repository": {
    "type": "git",
    "url": "https://i-Spiral@dev.azure.com/i-Spiral/CLM_Cypress/_git/CLM_Cypress"
  },
  "keywords": [
    "Automated",
    "Cypress",
    "Tests"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@faker-js/faker": "^9.3.0",
    "@percy/cypress": "^3.1.3",
    "cypress-multi-reporters": "^2.0.4",
    "fs": "^0.0.1-security",
    "mocha-junit-reporter": "^2.2.1",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "path": "^0.12.7",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "cypress": "^14.5.1"
  }
}
