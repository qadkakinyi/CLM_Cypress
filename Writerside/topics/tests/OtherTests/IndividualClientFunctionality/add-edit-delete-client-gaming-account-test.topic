    <chapter title="Test Scenarios">
        <procedure title="Add Client Gaming Accounts" id="test-1">
            <p><b>Scenario:</b> Precondition: Create Gaming Account Status</p>
            <p>Ensures a Gaming Account Status exists so the account can be created</p>
            <p><b>Priority:</b> Medium</p>
            <step>Go to Settings > Gaming Setups</step>
            <step>Open "Gaming Account Statuses" tab and click Add</step>
            <step>Enter status name and mapping reference, then Save</step>
            <chapter title="Expected Results">
                <p>• Status is created successfully</p>
            </chapter>
        </procedure>
        <procedure title="Edit client Gaming Accounts" id="test-2">
            <p><b>Scenario:</b> Precondition: Create Gaming Account Status</p>
            <p>Ensures a Gaming Account Status exists so the account can be created</p>
            <p><b>Priority:</b> Medium</p>
            <step>Go to Settings > Gaming Setups</step>
            <step>Open "Gaming Account Statuses" tab and click Add</step>
            <step>Enter status name and mapping reference, then Save</step>
            <chapter title="Expected Results">
                <p>• Status is created successfully</p>
            </chapter>
        </procedure>
        <procedure title="Delete client Gaming Accounts" id="test-3">
            <p><b>Scenario:</b> Precondition: Create Gaming Account Status</p>
            <p>Ensures a Gaming Account Status exists so the account can be created</p>
            <p><b>Priority:</b> Medium</p>
            <step>Go to Settings > Gaming Setups</step>
            <step>Open "Gaming Account Statuses" tab and click Add</step>
            <step>Enter status name and mapping reference, then Save</step>
            <chapter title="Expected Results">
                <p>• Status is created successfully</p>
            </chapter>
        </procedure>
    </chapter>

