    <chapter title="Test Scenarios">
        <procedure title="Add Client Checklist" id="test-1">
            <p><b>Scenario:</b> Precondition: Create Checklist in Settings</p>
            <p>Adds a reusable checklist in Settings to be selected on the client profile</p>
            <p><b>Priority:</b> High</p>
            <step>Visit Settings > Checklists</step>
            <step>Click Add, fill name/priority/mappingRef, pick regulation group, Save</step>
            <chapter title="Expected Results">
                <p>• Checklist is created and available in selection lists</p>
            </chapter>
        </procedure>
