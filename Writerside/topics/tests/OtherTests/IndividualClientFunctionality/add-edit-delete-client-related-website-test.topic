    <chapter title="Test Scenarios">
        <procedure title="Add Client Related Website" id="test-1">
            <p><b>Scenario:</b> Seed Related Website Type</p>
            <p>Adds a Related Website Type in Settings for use in the client flow.</p>
            <step>Visit settings → Related Website Types → Add → Fill name & mapping ref → Save</step>
            <chapter title="Expected Results">
                <p>• Type “Business Website” is created successfully.</p>
            </chapter>
        </procedure>
        <procedure title="Edit Client Related website" id="test-2">
