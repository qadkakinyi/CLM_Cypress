    <chapter title="Test Scenarios">
        <procedure title="Adds Alternative Name" id="test-1">
            <p><b>Scenario:</b> Add Alternative Name</p>
            <p>Adds a new alias to the individual client using a faker-generated first name</p>
            <p><b>Priority:</b> Medium</p>
            <p><b>Test Data:</b> Faker-generated firstName (duplicated to form "First First")</p>
            <step>Load individual client from fixture and navigate to their profile</step>
            <step>Navigate to Alternative Names section</step>
            <step>Click Add, fill in name, click Save</step>
            <chapter title="Expected Results">
                <p>• The alternative name is saved and confirmation message is shown</p>
            </chapter>
        </procedure>
        <procedure title="Deletes Alternative Names" id="test-2">
