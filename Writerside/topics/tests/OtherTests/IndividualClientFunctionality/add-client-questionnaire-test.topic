        <procedure title="Adds questionnaire type, creates question categories, creates a question then adds a questionnaire" id="test-1">
            <p>Creates N questions under Settings → Questions, including default answers</p>
            <step>Visit Settings → Questions</step>
            <step>Click Add, fill metadata (name, regulation group, category, client type, setup type, etc.)</step>
            <step>Save question, then add a default answer</step>
            <chapter title="Expected Results">
                <p>• Question and its answer are created successfully</p>
            </chapter>
        </procedure>
    </chapter>

