    <chapter title="Test Scenarios">
        <procedure title="Add Client Document" id="test-1">
            <p><b>Scenario:</b> Add Client Document</p>
            <p>Adds a new document to the individual client using a predefined document template</p>
            <p><b>Priority:</b> Medium</p>
            <p><b>Test Data:</b> Faker-generated document number and comment text</p>
            <step>Load client from fixture and navigate to newest client</step>
            <step>Open Documents section and click Add</step>
            <step>Pick document, collection status, country, form; fill document number and comment</step>
            <step>Pick certified/reviewed users and click Save</step>
            <chapter title="Expected Results">
                <p>• Document is saved and visible in the grid</p>
            </chapter>
        </procedure>
