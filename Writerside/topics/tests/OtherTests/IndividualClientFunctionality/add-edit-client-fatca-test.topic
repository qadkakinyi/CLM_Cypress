    <chapter title="Test Suites">
        <chapter title="Add, Delete Client FATCA">
        </chapter>
    </chapter>

    <chapter title="Test Scenarios">
        <procedure title="Add Client FATCA" id="test-1">
            <p>Ensures required reference data exists before client-level FATCA can be added</p>
            <step>Visit Settings → FATCA Setup</step>
            <step>Add FATCA Status with random mapping reference and save</step>
            <step>Add FATCA Entity Categorization (“Test Category”) and save</step>
            <step>Add FATCA Document (“Test Document”) and save</step>
            <step>Add FATCA CRS Entity Categorization (“Test CRS”) and save</step>
            <chapter title="Expected Results">
                <p>• All four reference records are present and selectable on the client FATCA form</p>
            </chapter>
        </procedure>
    </chapter>

    <chapter title="Execution">
       <chapter title="Run Individual Test">
           <code-block lang="bash">
               npx cypress run --spec "OtherTests/IndividualClientFunctionality/Add_Edit_Client_FATCA_test.cy.ts"
           </code-block>
       </chapter>
      
       <chapter title="Run in Interactive Mode">
           <code-block lang="bash">
               npx cypress open --spec "OtherTests/IndividualClientFunctionality/Add_Edit_Client_FATCA_test.cy.ts"
           </code-block>
       </chapter>
