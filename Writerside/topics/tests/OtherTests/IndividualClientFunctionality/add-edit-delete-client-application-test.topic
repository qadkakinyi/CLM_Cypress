    <chapter title="Test Scenarios">
        <procedure title="Add Client Applications" id="test-1">
            <p><b>Scenario:</b> Add Client Application</p>
            <p>Creates a new application for the selected client with required dropdowns and reference</p>
            <p><b>Priority:</b> Medium</p>
            <p><b>Test Data:</b> Faker-generated email, comments, and external reference</p>
            <step>Load individual client from fixture and open newest client menu</step>
            <step>Navigate to Applications, click Add</step>
            <step>Select purpose of transaction and approver, fill reference, user, email, comments</step>
            <step>Save the application</step>
            <chapter title="Expected Results">
                <p>• Application is saved and visible in the list</p>
            </chapter>
        </procedure>
