    <chapter title="Test Scenarios">
        <procedure title="Adds an evaluation" id="test-1">
            <p><b>Scenario:</b> Add an Evaluation</p>
            <p>Creates a new evaluation for an individual client and completes all steps</p>
            <p><b>Priority:</b> Medium</p>
            <p><b>Test Data:</b> Faker-generated reason text</p>
            <step>Load client from fixture and navigate to newest client</step>
            <step>Open Evaluations and click Add</step>
            <step>Step 1: enter reason for evaluation and proceed</step>
            <step>Step 2: iterate each criteria dropdown, select first option, and close the dropdown</step>
            <step>Step 3: click Evaluate, then Complete</step>
            <chapter title="Expected Results">
                <p>• Evaluation is processed and completed without errors</p>
            </chapter>
        </procedure>
    </chapter>

