    <chapter title="Test Scenarios">
        <procedure title="Edit Individual Profile" id="test-1">
            <p><b>Scenario:</b> Edit Individual Profile</p>
            <p>Navigates to the newest client’s profile and updates the middle name.</p>
            <step>Load client from fixture</step>
            <step>Navigate to Profile section</step>
            <step>Type random middle name and Save</step>
            <step>Capture client_id from URL for subsequent tests</step>
            <chapter title="Expected Results">
                <p>• Profile is saved successfully and client_id is available for reuse</p>
            </chapter>
        </procedure>
