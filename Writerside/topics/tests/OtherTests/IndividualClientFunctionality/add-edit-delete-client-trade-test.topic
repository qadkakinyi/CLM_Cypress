   <chapter title="Overview">
       <p><b>File:</b> <code>OtherTests/IndividualClientFunctionality/Add_Edit_Delete_Client_Trade_test.cy.ts</code></p>
        <p><b>Folder:</b> <code>OtherTests/IndividualClientFunctionality</code></p>
        <p><b>Description:</b> Validates add/edit/delete flows for a client's Trades detail line. Seeds a Trade Type prerequisite.</p>
        <p><b>Priority:</b> Medium</p>
        <p><b>Owner:</b> QA</p>
        <p><b>Tags:</b> individual, trades, crud</p>
        <p><b>Dependencies:</b> navigateToNewestClientMenu</p>
    </chapter>

    <chapter title="Test Suites">
        <chapter title="Add, Edit, Delete Client Trade">
        </chapter>
    </chapter>

    <chapter title="Test Scenarios">
        <procedure title="Add Client Trade" id="test-1">
            <p><b>Scenario:</b> Seed Trade Type</p>
            <p>Adds a Trade Type in Settings (e.g., “Day trading”) to be used during client trade creation.</p>
            <step>Visit Settings → Trade Types → Add → Enter name & mapping reference → Save</step>
            <chapter title="Expected Results">
                <p>• Trade type is created successfully.</p>
            </chapter>
        </procedure>
        <procedure title="Edit client trade" id="test-2">
            <p><b>Scenario:</b> Seed Trade Type</p>
            <p>Adds a Trade Type in Settings (e.g., “Day trading”) to be used during client trade creation.</p>
            <step>Visit Settings → Trade Types → Add → Enter name & mapping reference → Save</step>
            <chapter title="Expected Results">
                <p>• Trade type is created successfully.</p>
            </chapter>
        </procedure>
        <procedure title="Delete client trade" id="test-3">
            <p><b>Scenario:</b> Seed Trade Type</p>
            <p>Adds a Trade Type in Settings (e.g., “Day trading”) to be used during client trade creation.</p>
            <step>Visit Settings → Trade Types → Add → Enter name & mapping reference → Save</step>
            <chapter title="Expected Results">
                <p>• Trade type is created successfully.</p>
            </chapter>
        </procedure>
    </chapter>

