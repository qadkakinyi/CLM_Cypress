    <chapter title="Test Scenarios">
        <procedure title="Generate Regulation Group Hash Key" id="test-1">
            <p><b>Scenario:</b> Generate Regulation Group Hash Key</p>
            <p>Generates a hash key from provider selection and future expiration date</p>
            <step>1. Open system settings > Account 2. Click generate key icon 3. Select provider 4. Enter formatted date 5. Select checkboxes and expiration 6. Save and capture hash key</step>
            <chapter title="Expected Results">
                <p>• Hash key is generated and captured</p>
            </chapter>
        </procedure>
        <procedure title="Adds A Rule" id="test-2">
