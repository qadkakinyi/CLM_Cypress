    <chapter title="Test Scenarios">
        <procedure title="Execute Rule" id="test-1">
            <step>Navigate to /processes/handle-rules.</step>
            <step>In the grid filter (col 4), type "3A".</step>
            <step>Select the checkbox in row 2 to target the rule(s).</step>
            <chapter title="Expected Results">
                <p>• The desired rule(s) are filtered and selected for subsequent actions.</p>
            </chapter>
        </procedure>
