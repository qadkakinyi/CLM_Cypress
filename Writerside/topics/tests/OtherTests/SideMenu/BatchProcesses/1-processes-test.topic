        <chapter title="Processes Menu">
        </chapter>
    </chapter>

    <chapter title="Test Scenarios">
        <procedure title="Toggles first level menu list items visibility" id="test-1">
            <p>Confirms that the Processes menu can be expanded and its first-level menu items are visible.</p>
            <p><b>Priority:</b> Medium</p>
            <step>Click the Processes menu item.</step>
            <step>Verify that the first-level menu list items are visible.</step>
            <step>Ensure that the number of first-level items is greater than four.</step>
            <chapter title="Expected Results">
                <p>• First-level menu items are visible and contain more than four items.</p>
            </chapter>
        </procedure>
    </chapter>

    <chapter title="Execution">
       <chapter title="Run Individual Test">
           <code-block lang="bash">
