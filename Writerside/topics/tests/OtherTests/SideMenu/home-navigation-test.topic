        <chapter title="Home Navigations">
        </chapter>
    </chapter>

    <chapter title="Test Scenarios">
        <procedure title="Visit the homepage and various sections" id="test-1">
            <p><b>Scenario:</b> Visit Homepage and Various Sections</p>
            <p>Loads the dashboard and verifies multiple sections (Tour, Pending Actions, My Tasks, Key Metrics, Token Balances) are accessible.</p>
            <p><b>Priority:</b> High</p>
            <step>Visit dashboard.</step>
            <step>Confirm URL path is "/main/dashboard".</step>
            <step>Verify visibility of "Tour" and "Pending Actions".</step>
            <step>Navigate to "My Tasks" and verify "Add Task" button is present.</step>
            <step>Navigate to "Key Metrics" and verify "Transaction Volume".</step>
            <step>Navigate to "Token Balances" and verify "Account Token Balances".</step>
            <chapter title="Expected Results">
                <p>• All sections are visible and navigable.</p>
            </chapter>
        </procedure>
