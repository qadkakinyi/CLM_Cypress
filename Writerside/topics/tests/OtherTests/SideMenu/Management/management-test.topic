      title="Management Module - Navigation (Parametrized)" id="management-test">

   <show-structure for="chapter,procedure" depth="2"/>
  
   <chapter title="Overview">
       <p><b>File:</b> <code>OtherTests/SideMenu/Management/Management_test.cy.ts</code></p>
        <p><b>Folder:</b> <code>OtherTests/SideMenu/Management</code></p>
        <p><b>Description:</b> Verifies that each Management menu item navigates to the correct page and displays the expected section heading.</p>
        <p><b>Priority:</b> Medium</p>
        <p><b>Owner:</b> QA Team</p>
        <p><b>Tags:</b> regression, navigation, management, ui</p>
        <p><b>Dependencies:</b> cypress, getByDataCy</p>
    </chapter>

    <chapter title="Test Suites">
        <chapter title="Management Module">
        </chapter>
    </chapter>

    <chapter title="Test Scenarios">
        <procedure title="opens ${route.assertion} page" id="test-1">
            <p><b>Scenario:</b> Open Management Page</p>
            <p>Opens a specific Management page and verifies URL and expected heading.</p>
            <p><b>Priority:</b> Medium</p>
            <p><b>Test Data:</b> index = route.index, expectedPath = route.route, expectedText = route.assertion.</p>
            <step>Visit /main/dashboard and pin the sidebar if the unpin icon is present.</step>
            <step>Expand the Management menu and click the item by index.</step>
            <step>Verify the browser path equals the expected route and the page contains the expected assertion text.</step>
            <chapter title="Expected Results">
                <p>• Correct page loads with matching URL and visible heading text.</p>
            </chapter>
        </procedure>
    </chapter>

    <chapter title="Execution">
       <chapter title="Run Individual Test">
           <code-block lang="bash">
               npx cypress run --spec "OtherTests/SideMenu/Management/Management_test.cy.ts"
           </code-block>
       </chapter>
      
       <chapter title="Run in Interactive Mode">
           <code-block lang="bash">
               npx cypress open --spec "OtherTests/SideMenu/Management/Management_test.cy.ts"
           </code-block>
       </chapter>
   </chapter>

