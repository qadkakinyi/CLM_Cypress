    <chapter title="Test Scenarios">
        <procedure title="Opens power bi menu and menu shows menu items" id="test-1">
            <p><b>Scenario:</b> Open Power BI Menu and Check Items</p>
            <p>Opens Power BI menu and verifies that menu items are clickable.</p>
            <step>Visit dashboard, click on Power-BI Reports menu.</step>
            <step>Click on "Risk Assessment Report first Redesign".</step>
            <chapter title="Expected Results">
                <p>• The selected report loads successfully.</p>
            </chapter>
        </procedure>
