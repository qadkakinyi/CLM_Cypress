    <chapter title="Test Scenarios">
        <procedure title="Adds a Currency Rate" id="test-1">
            <p><b>Scenario:</b> Add Currency Rate</p>
            <p>Adds a new currency rate to the system</p>
            <step>1. Navigate to the Currency Rates settings page 2. Click the "Add" button 3. Select the "From Currency" 4. Select the "To Currency" 5. Enter the date 6. Enter the rate value 7. Click Save</step>
            <chapter title="Expected Results">
                <p>• Currency rate is successfully added and confirmation message is shown</p>
            </chapter>
        </procedure>
