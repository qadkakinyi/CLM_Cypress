    <chapter title="Test Scenarios">
        <procedure title="Adds Dynamic Report Setup" id="test-1">
            <p><b>Scenario:</b> Precondition - Add Email Template</p>
            <p>Creates an email template to be linked with a dynamic report setup</p>
            <step>1. Navigate to Email Templates page 2. Click "Add" 3. Fill out Subject, select related Intro/Ending, and type email body 4. Save the template</step>
            <chapter title="Expected Results">
                <p>• Email template is saved successfully</p>
            </chapter>
        </procedure>
