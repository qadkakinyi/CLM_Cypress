    <chapter title="Test Scenarios">
        <procedure title="Adds a Related Website Type" id="test-1">
            <p><b>Scenario:</b> Add Related Website Type</p>
            <p>Adds a new Related Website Type entry in system settings</p>
            <p><b>Priority:</b> Medium</p>
            <p><b>Test Data:</b> Faker-generated related website type name and mapping reference</p>
            <step>Navigate to Related Website Types settings</step>
            <step>Click "Add", enter name, mapping reference, and save</step>
            <chapter title="Expected Results">
                <p>• New Related Website Type is added and confirmation message is displayed</p>
            </chapter>
        </procedure>
