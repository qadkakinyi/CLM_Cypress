    <chapter title="Test Scenarios">
        <procedure title="Add a custom field to a form" id="test-1">
            <p><b>Scenario:</b> Add Custom Field</p>
            <p>Creates a new custom field mapped to "Custom Fields" table</p>
            <p><b>Priority:</b> Medium</p>
            <p><b>Test Data:</b> Name: "Test field"; Mapping Reference: faker string(12)</p>
            <step>Navigate to Settings → Custom Fields</step>
            <step>Click Add; fill Field Name, Mapping Reference, Order</step>
            <step>Select Reference Table = Custom Fields; Regulation Group; Field Type = Text</step>
            <step>Enable Nullable; click Save</step>
            <chapter title="Expected Results">
                <p>• Toast: "The custom field has been added."</p>
            </chapter>
        </procedure>
