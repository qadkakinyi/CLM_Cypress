    <chapter title="Test Scenarios">
        <procedure title="Adds A Document Category" id="test-1">
            <p><b>Scenario:</b> Add Document Category</p>
            <p>Creates a new document category with a static name and faker-generated mapping reference</p>
            <p><b>Priority:</b> Medium</p>
            <p><b>Test Data:</b> Name: "Test Ledger", Mapping Reference: faker-generated alphanumeric(11)</p>
            <step>Navigate to Settings → Document Categories</step>
            <step>Click Add to open the add form</step>
            <step>Fill in name and mapping reference</step>
            <step>Click Save</step>
            <chapter title="Expected Results">
                <p>• Toast: "Document category has been added."</p>
            </chapter>
        </procedure>
