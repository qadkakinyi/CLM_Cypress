    <chapter title="Test Scenarios">
        <procedure title="Add bank" id="test-1">
            <p><b>Scenario:</b> Add Bank</p>
            <p>Adds a new bank entry using dynamically generated data</p>
            <p><b>Priority:</b> High</p>
            <p><b>Test Data:</b> Faker-generated bank code and mapping reference</p>
            <step>Navigate to banks settings page</step>
            <step>Click 'Add', fill in form, click 'Save'</step>
            <chapter title="Expected Results">
                <p>• Bank is saved and confirmation message appears</p>
            </chapter>
        </procedure>
