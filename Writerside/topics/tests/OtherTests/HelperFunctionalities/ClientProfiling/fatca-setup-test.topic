    <chapter title="Test Scenarios">
        <procedure title="Adds FATCA Setup" id="test-1">
            <p><b>Scenario:</b> Add FATCA Status</p>
            <p>Creates a new FATCA status with a name and mapping reference.</p>
            <p><b>Priority:</b> Medium</p>
            <step>Navigate to Settings → FATCA Setup</step>
            <step>Click Add, fill name and reference, click Save</step>
            <chapter title="Expected Results">
                <p>• "Fatca Status has been added."</p>
            </chapter>
        </procedure>
