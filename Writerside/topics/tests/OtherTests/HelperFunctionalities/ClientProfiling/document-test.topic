    <chapter title="Test Scenarios">
        <procedure title="Adds a document" id="test-1">
            <p><b>Scenario:</b> Add Document</p>
            <p>Creates a new document with faker-generated name and mapping reference, assigning type, client type, regulation group, and capacity.</p>
            <p><b>Priority:</b> High</p>
            <p><b>Test Data:</b> Name: "DKA Test Document <faker word>", Mapping Reference: faker-generated alphanumeric(11)</p>
            <step>Navigate to Settings → Documents</step>
            <step>Click Add to open the form</step>
            <step>Fill in name, name in portal, mapping reference</step>
            <step>Select document type, client type, regulation group, and capacity</step>
            <step>Click Save</step>
            <chapter title="Expected Results">
                <p>• Toast: "Document has been added."</p>
            </chapter>
        </procedure>
