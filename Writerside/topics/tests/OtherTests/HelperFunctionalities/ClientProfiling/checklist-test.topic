        <procedure title="Adds A Checklist" id="test-1">
            <p><b>Scenario:</b> Add Checklist</p>
            <p>Adds a new checklist with name, priority, mapping reference, and regulation group</p>
            <p><b>Priority:</b> High</p>
            <p><b>Test Data:</b> Faker-generated mapping reference</p>
            <step>Navigate to checklists settings</step>
            <step>Click 'Add', enter name, priority, mapping reference</step>
            <step>Select regulation group from dropdown</step>
            <step>Save checklist</step>
            <chapter title="Expected Results">
                <p>• Checklist is saved and confirmation message appears</p>
            </chapter>
        </procedure>
