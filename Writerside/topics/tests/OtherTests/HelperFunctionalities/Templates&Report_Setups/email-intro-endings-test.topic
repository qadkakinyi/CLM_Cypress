    <chapter title="Test Scenarios">
        <procedure title="Adds an Intro And Ending" id="test-1">
            <p><b>Scenario:</b> Add Intro And Ending</p>
            <p>Adds a new intro and ending template</p>
            <step>1. Navigate to Intro & Endings settings page. 2. Click "Add". 3. Enter Name. 4. Enter Intro text. 5. Enter Ending text. 6. Save the record.</step>
            <chapter title="Expected Results">
                <p>• Intro & Ending record is added and a confirmation message is shown.</p>
            </chapter>
        </procedure>
