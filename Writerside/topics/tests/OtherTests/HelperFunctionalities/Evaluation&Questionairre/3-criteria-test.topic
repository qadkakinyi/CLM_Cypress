    <chapter title="Test Scenarios">
        <procedure title="Adds a Criteria" id="test-1">
            <p><b>Scenario:</b> Add Criteria</p>
            <step>Navigate to Criteria settings</step>
            <step>Click Add button</step>
            <step>Fill in name, risk points, mapping reference, and select required dropdowns</step>
            <step>Uncheck "Include in Evaluation"</step>
            <step>Save the criterion</step>
            <chapter title="Expected Results">
                <p>• Criterion is successfully added</p>
            </chapter>
        </procedure>
