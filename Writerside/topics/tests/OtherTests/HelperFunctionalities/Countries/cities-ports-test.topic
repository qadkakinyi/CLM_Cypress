    <chapter title="Test Scenarios">
        <procedure title="Imports Cities/Ports from file" id="test-1">
            <p><b>Scenario:</b> Import Cities/Ports from file</p>
            <p>Uploads an Excel file to import multiple cities/ports</p>
            <p><b>Priority:</b> Medium</p>
            <p><b>Test Data:</b> CitiesPorts_Template.xlsx from fixtures</p>
            <step>Navigate to Cities/Ports settings</step>
            <step>Click "Import Cities/Ports From File"</step>
            <step>Select the provided Excel template</step>
            <step>Click "Import"</step>
            <chapter title="Expected Results">
                <p>• Cities/ports from the file are imported and a confirmation message is shown</p>
            </chapter>
        </procedure>
