    <chapter title="Test Scenarios">
        <procedure title="Edits A Evaluation Grade" id="test-1">
            <p><b>Scenario:</b> Edit Country Evaluation Grade</p>
            <p>Filters by regulation group, edits Kenya’s grade to High, saves, and verifies success toast</p>
            <p><b>Priority:</b> High</p>
            <step>Open Country Evaluation Grades</step>
            <step>Filter by “Default” regulation group</step>
            <step>Filter grid by “Kenya” and click edit</step>
            <step>Change grade to “High” and save</step>
            <chapter title="Expected Results">
                <p>• “The country evaluation grade has been updated.” is shown</p>
            </chapter>
        </procedure>
