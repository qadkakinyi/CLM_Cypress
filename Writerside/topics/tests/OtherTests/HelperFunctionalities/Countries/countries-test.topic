    <chapter title="Test Scenarios">
        <procedure title="Edits A Country" id="test-1">
            <p><b>Scenario:</b> Edit Country</p>
            <p>Updates an existing country name and reverts the change</p>
            <p><b>Priority:</b> Medium</p>
            <p><b>Test Data:</b> Existing country "Kenya"</p>
            <step>Search for the country</step>
            <step>Click edit, change the name to "Kenia"</step>
            <step>Save and confirm update</step>
            <step>Revert the name back to "Kenya"</step>
            <chapter title="Expected Results">
                <p>• The country name is updated successfully and reverted with confirmation messages</p>
            </chapter>
        </procedure>
