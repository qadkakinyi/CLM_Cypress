    <chapter title="Test Scenarios">
        <procedure title="Adds a Country Category" id="test-1">
            <p><b>Scenario:</b> Add Country Category</p>
            <p>Creates a new country category with a faker-generated name</p>
            <p><b>Priority:</b> Medium</p>
            <p><b>Test Data:</b> Faker-generated name and mapping reference</p>
            <step>Navigate to Country Categories settings</step>
            <step>Click "Add", fill in name and mapping reference, click Save</step>
            <chapter title="Expected Results">
                <p>• New country category is saved and confirmation message is shown</p>
            </chapter>
        </procedure>
