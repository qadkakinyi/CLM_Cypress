    <chapter title="Test Scenarios">
        <procedure title="Add Client Policy" id="test-1">
            <p><b>Scenario:</b> Add Client Policy</p>
            <p>Adds a new policy for an existing client including random financial and date data</p>
            <p><b>Priority:</b> High</p>
            <p><b>Test Data:</b> Random faker-generated policy number, values, and dates</p>
            <step>Navigate to Know Your Clients</step>
            <step>Select a client and open the Policies section</step>
            <step>Click Add Policy and fill in all required fields</step>
            <step>Submit and save the policy</step>
            <chapter title="Expected Results">
                <p>• A new client policy is saved and displayed in the table</p>
            </chapter>
        </procedure>
