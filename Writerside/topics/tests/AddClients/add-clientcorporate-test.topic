      xsi:noNamespaceSchemaLocation="https://resources.jetbrains.com/writerside/1.0/topic.v2.xsd"
      title="AddClients - Corporate Client Management" id="add-clientcorporate-test">

   <show-structure for="chapter,procedure" depth="2"/>
  
   <chapter title="Overview">
       <p><b>File:</b> <code>AddClients/Add_ClientCorporate_test.cy.ts</code></p>
        <p><b>Folder:</b> <code>AddClients</code></p>
        <p><b>Description:</b> This test verifies the functionality of adding a corporate client by filling out a form with company details, including registered name, registration number, regulation group, client status, contact information, and capital amounts, then confirming successful submission with a success message.</p>
        <p><b>Priority:</b> High</p>
        <p><b>Owner:</b> QA Team</p>
        <p><b>Tags:</b> regression, smoke, corporate-clients, client-management</p>
        <p><b>Dependencies:</b> user-authentication, faker-js</p>
    </chapter>

    <chapter title="Test Suites">
        <chapter title="Add Client Corporate">
        </chapter>
    </chapter>

    <chapter title="Test Scenarios">
        <procedure title="Add Client Corporate" id="test-1">
            <p><b>Scenario:</b> Complete Corporate Client Creation</p>
            <p>Successfully adds a corporate client with all required and optional fields populated</p>
            <p><b>Priority:</b> High</p>
            <p><b>Test Data:</b> Dynamic faker data for company details, contact info, and financial data</p>
            <step>Navigate to Know Your Clients section</step>
            <step>Click Add Corporate Client button</step>
            <step>Fill in registered all required fields</step>
            <step>Submit the form by clicking save button</step>
            <step>Verify success message appears</step>
            <step>Save company name to fixtures file for future test reference</step>
            <chapter title="Expected Results">
                <p>• Corporate client is successfully created and added to the system</p>
                <p>• Success message "The Client Corporate has been added." is displayed</p>
                <p>• Client data is saved to fixtures file for reuse</p>
            </chapter>
        </procedure>
    </chapter>

    <chapter title="Execution">
       <chapter title="Run Individual Test">
           <code-block lang="bash">
               npx cypress run --spec "AddClients/Add_ClientCorporate_test.cy.ts"
           </code-block>
       </chapter>
      
       <chapter title="Run in Interactive Mode">
           <code-block lang="bash">
               npx cypress open --spec "AddClients/Add_ClientCorporate_test.cy.ts"
           </code-block>
       </chapter>
   </chapter>

    <chapter title="Source Code">
       <p><b>File Path:</b> <code>AddClients/Add_ClientCorporate_test.cy.ts</code></p>
